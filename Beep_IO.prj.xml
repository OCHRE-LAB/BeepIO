		<nme>Beep-IO Send</nme>
		<pri>100</pri>
		<Action sr="act0" ve="7">
			<code>129</code>
			<label>Encode Parameter 1 as UTF-8 hex</label>
			<Str sr="arg0" ve="3">var sendtext = local("par1");
var sendhex = "";
var sendready = "no";

sendtext = sendtext == null ? "" : String(sendtext);

if (!sendtext || sendtext === "%par1") {
    flash("Enter your message in Parameter 1.");
} else {
    try {
        var bytes = "";

        for (var i = 0; i &lt; sendtext.length &amp;&amp; bytes.length &lt; 20; i++) {
            var ch = sendtext.charAt(i);
            var code = sendtext.charCodeAt(i);

            if (code &gt;= 0xD800 &amp;&amp; code &lt;= 0xDBFF &amp;&amp;
                i + 1 &lt; sendtext.length) {
                var next = sendtext.charCodeAt(i + 1);

                if (next &gt;= 0xDC00 &amp;&amp; next &lt;= 0xDFFF) {
                    ch += sendtext.charAt(++i);
                }
            }

            var encoded = unescape(encodeURIComponent(ch));

            if (bytes.length + encoded.length &gt; 20) {
                break;
            }

            bytes += encoded;
        }

        for (var j = 0; j &lt; bytes.length; j++) {
            sendhex += ("0" + bytes.charCodeAt(j).toString(16)).slice(-2);
        }

        if (bytes.length) {
            sendready = "yes";
        }
    } catch (err) {
        sendhex = "";
        sendready = "no";
        flash("Invalid text encoding.");
    }
}</Str>
